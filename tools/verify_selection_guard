#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/tools/lib/verify_suites.sh"

collect_all_tests "$ROOT"
TESTS=(
  "${FAST_TESTS[@]}" "${CORE_TESTS[@]}" "${GEM_TESTS[@]}"
  "${BATTLE_TESTS[@]}" "${ADVENTURE_TESTS[@]}" "${PERSISTENCE_TESTS[@]}"
  "${UI_TESTS[@]}" "${LOCALIZATION_TESTS[@]}" "${AI_TESTS[@]}"
  "${ENCOUNTER_TESTS[@]}" "${EDITOR_TESTS[@]}" "${MAP_TESTS[@]}"
  "${RELIC_TESTS[@]}"
)
dedupe_selected_tests

missing="$(comm -23 \
  <(printf '%s\n' "${ALL_TESTS[@]}" | sort) \
  <(printf '%s\n' "${TESTS[@]}" | sort))"
if [[ -n "$missing" ]]; then
  echo "VERIFY_SELECTION_GUARD_FAIL unassigned tests:" >&2
  printf '%s\n' "$missing" >&2
  exit 1
fi

expect_route() {
  local label="$1"
  local changed="$2"
  shift 2
  select_changed_tests "$ROOT" "$changed"
  local expected
  for expected in "$@"; do
    if ! printf '%s\n' "${TESTS[@]}" | grep -Fxq "$expected"; then
      echo "VERIFY_SELECTION_GUARD_FAIL route=$label missing=$expected" >&2
      return 1
    fi
  done
}

expect_route displacement 'scripts/rules/displacement.gd' displacement_test
expect_route gem_tag_resolver 'scripts/rules/gem_tag_resolver.gd' gem_tag_resolver_test gem_semantic_contract_test
expect_route arc_bounce 'scripts/rules/gem_effects.gd' arc_bounce_test
expect_route red_skill 'scripts/rules/gem_effects.gd' skill_test
expect_route status_rules 'scripts/rules/status_rules.gd' status_test
expect_route encounter_resource 'resources/encounters/example.json' encounter_load_test encounter_composition_test
expect_route encounter_mixed $'resources/encounters/example.json\nscripts/ui/battle_hud_presenter.gd' encounter_load_test encounter_composition_test ui_compile_test
expect_route unit_resource 'resources/units/example.json' encounter_load_test enemy_initial_gem_contract_test
expect_route editor_codec 'scripts/debug/battle_editor_encounter_codec.gd' battle_editor_encounter_codec_test
expect_route map_source 'scripts/map/water_autotile.gd' water_autotile_test water_render_contract_test

echo "VERIFY_SELECTION_GUARD_PASS tests=${#ALL_TESTS[@]}"
