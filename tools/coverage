#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONTRACT="$ROOT/tests/contracts/gem_semantics.json"
OUTPUT="$ROOT/artifacts/verify/semantic-coverage.json"
mkdir -p "$(dirname "$OUTPUT")"

if ! bash "$ROOT/tools/semantic_contract_guard_self_test"; then
  exit 1
fi

if ! bash "$ROOT/tools/semantic_contract_guard"; then
  exit 1
fi

jq -n \
  --slurpfile defs "$ROOT/resources/gems/gem_defs.json" \
  --slurpfile contract "$CONTRACT" '
  def verified: [$contract[0].cases[].covers[]];
  def rows:
    [$defs[0] | to_entries[] as $gem |
      ["red", "blue", "black"][] as $slot |
      range(1; (($gem.value.max_stack_level // 3) + 1)) as $level |
      ($gem.key + ":" + $slot + ":" + ($level|tostring)) as $key |
      {
        key: $key,
        gem_id: $gem.key,
        slot: $slot,
        level: $level,
        status: (if (verified | index($key)) then "VERIFIED" else "UNVERIFIED" end)
      }
    ];
  (rows) as $rows |
  {
    authority: $contract[0].source,
    definition: "Only executable design-contract cases count as VERIFIED. Ordinary tests and snapshots do not.",
    verified: ($rows | map(select(.status == "VERIFIED")) | length),
    total: ($rows | length),
    coverage_percent: ((($rows | map(select(.status == "VERIFIED")) | length) * 10000 / ($rows | length) | floor) / 100),
    rows: $rows,
    combo_contracts: [$contract[0].cases[] | select(.covers[0] | startswith("combo:")) | .covers[]]
  }' > "$OUTPUT"

jq -r '"SEMANTIC_COVERAGE verified=\(.verified) total=\(.total) coverage=\(.coverage_percent)% report=artifacts/verify/semantic-coverage.json",
  (.rows[] | select(.status == "UNVERIFIED") | "UNVERIFIED \(.key)")' "$OUTPUT"

SEMANTIC_COVERAGE_MIN="${SEMANTIC_COVERAGE_MIN:-87.17}"
jq -e --argjson minimum "$SEMANTIC_COVERAGE_MIN" \
  '.coverage_percent >= $minimum' "$OUTPUT" >/dev/null
