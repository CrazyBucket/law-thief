#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
checked=0
invalid=0
mojibake=0
while IFS= read -r file; do
  checked=$((checked + 1))
  if ! iconv -f UTF-8 -t UTF-8 "$file" >/dev/null 2>&1; then
    echo "SOURCE_ENCODING_GUARD_INVALID file=${file#"$ROOT/"}" >&2
    invalid=$((invalid + 1))
	continue
	fi
	if LC_ALL=C grep -q $'\xEF\xBF\xBD' "$file"; then
		echo "SOURCE_ENCODING_GUARD_REPLACEMENT_CHARACTER file=${file#"$ROOT/"}" >&2
		mojibake=$((mojibake + 1))
		continue
	fi
	# These characters are stable signatures of UTF-8 Chinese decoded as GBK and
	# written back as valid UTF-8. Charset validation alone cannot catch it.
	if grep -q -E '[锛銆鈥鈫]' "$file"; then
		echo "SOURCE_ENCODING_GUARD_MOJIBAKE_SIGNATURE file=${file#"$ROOT/"}" >&2
		mojibake=$((mojibake + 1))
  fi
done < <(find "$ROOT" -type f \( -name '*.gd' -o -name '*.md' -o -name '*.json' -o -name '*.csv' \) \
  ! -path "$ROOT/.git/*" ! -path "$ROOT/.godot/*" ! -path "$ROOT/artifacts/*" | sort)

if (( invalid > 0 || mojibake > 0 )); then
  echo "SOURCE_ENCODING_GUARD_FAIL checked=$checked invalid=$invalid mojibake=$mojibake" >&2
  exit 1
fi
echo "SOURCE_ENCODING_GUARD_PASS checked=$checked charset=UTF-8 mojibake=$mojibake"
