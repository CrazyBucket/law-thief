#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MAX_LINES=600
BOUNDARY_DOC="$ROOT/docs/file-size-boundaries.md"

if [[ ! -f "$BOUNDARY_DOC" ]]; then
  echo "FILE_SIZE_GUARD_FAIL missing boundary register: docs/file-size-boundaries.md" >&2
  exit 1
fi

checked=0
documented=0
missing=0
while IFS= read -r file; do
  rel="${file#"$ROOT/"}"
  lines="$(wc -l < "$file")"
  if (( lines <= MAX_LINES )); then
    continue
  fi
  checked=$((checked + 1))
  if grep -Fq "| \`$rel\` |" "$BOUNDARY_DOC"; then
    documented=$((documented + 1))
  else
    echo "FILE_SIZE_GUARD_MISSING lines=$lines file=$rel" >&2
    missing=$((missing + 1))
  fi
done < <(find "$ROOT/scripts" -type f -name '*.gd' \
  ! -path "$ROOT/scripts/tests/*" \
  ! -path "$ROOT/scripts/tools/*" | sort)

if (( missing > 0 )); then
  echo "FILE_SIZE_GUARD_FAIL checked=$checked documented=$documented missing=$missing max_lines=$MAX_LINES" >&2
  exit 1
fi
echo "FILE_SIZE_GUARD_PASS checked=$checked documented=$documented max_lines=$MAX_LINES"
