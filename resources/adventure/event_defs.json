  "event_abandoned_cache": {
    "entry": "start",
    "nodes": {
      "start": {
        "title": "塌墙后的储藏室",
        "body": "潮湿的墙砖后藏着一只旧铁箱。里面有一袋钱，也有几包还能使用的药粉。",
        "options": [
