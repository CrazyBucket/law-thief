; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Law Thief"
config/description="窃律者 - 战术嫁祸战棋肉鸽 MVP"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameService="*res://scripts/services/game_service.gd"
RngService="*res://scripts/services/rng_service.gd"
SaveService="*res://scripts/services/save_service.gd"
SettingsService="*res://scripts/services/settings_service.gd"
ProfileService="*res://scripts/services/profile_service.gd"
AchievementService="*res://scripts/services/achievement_service.gd"
RunHistoryService="*res://scripts/services/run_history_service.gd"
DataRegistry="*res://scripts/services/data_registry.gd"
AudioService="*res://scripts/services/audio_service.gd"
I18nService="*res://scripts/services/i18n_service.gd"
DebugService="*res://scripts/services/debug_service.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[input]

ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
action_move={
"deadzone": 0.5,
"events": []
}
action_attack={
"deadzone": 0.5,
"events": []
}
action_extract={
"deadzone": 0.5,
"events": []
}
action_insert={
"deadzone": 0.5,
"events": []
}
action_trigger={
"deadzone": 0.5,
"events": []
}
end_turn={
"deadzone": 0.5,
"events": []
}

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
